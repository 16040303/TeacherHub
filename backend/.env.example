# Runtime mode: development | test | production
NODE_ENV=development

# Server port
PORT=3000

# MySQL/MariaDB connection string
# Example: mysql://teacherhub_user:teacherhub_password@localhost:3306/teacherhub
DATABASE_URL="mysql://root:@localhost:3306/teacherhub"

# JWT signing secret (minimum 32 chars). Must be unique per environment.
JWT_SECRET="replace-with-a-random-32-plus-character-secret"

# Access and refresh token lifetimes (jsonwebtoken format, e.g. 15m, 7d)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Comma-separated allow-list for browser origins.
# REQUIRED in production.
CORS_ALLOWED_ORIGINS="http://localhost:1604,http://127.0.0.1:1604,http://localhost:5173,http://127.0.0.1:5173"

# If running behind reverse proxy (e.g., nginx), set true.
TRUST_PROXY=false

# Request body limits
MAX_JSON_BODY_SIZE=1mb
MAX_URLENCODED_BODY_SIZE=1mb

# Auth endpoint rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Controls whether /uploads static serving is enabled.
# Keep false in production unless you intentionally expose uploaded files.
UPLOADS_PUBLIC_ENABLED=true

# Frontend URL for constructing verification links in emails
FRONTEND_URL="http://localhost:1604"

# Google OAuth client ID used to verify Google ID tokens
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# SMTP configuration for email sending
# Required in production. In development, emails are logged to console if missing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TeacherHub <noreply@teacherhub.local>"
