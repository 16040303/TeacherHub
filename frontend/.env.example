# Public frontend API base URL used by the client app (origin only; paths already include /api/...).
# Example local backend:
VITE_API_URL="http://localhost:3000"
# If you already use http://localhost:3000/api here, the client normalizes to avoid /api/api/... .

# Optional: disable Vite HMR when tooling automation requires it.
# Set to true only when needed.
VITE_DISABLE_HMR="false"
